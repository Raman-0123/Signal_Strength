# Durable database. Leave unset locally to use data/email_campaigns.db.
DATABASE_URL=postgresql+psycopg://user:password@host:5432/signal_campaigns

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/oauth/gmail/callback
PUBLIC_API_URL=http://127.0.0.1:8000
PUBLIC_APP_URL=http://localhost:8501/Email_Campaigns

# Generate with: python -c "import hashlib,getpass; print(hashlib.sha256(getpass.getpass().encode()).hexdigest())"
ADMIN_PASSWORD_SHA256=
ADMIN_EMAIL=your-personal-address@gmail.com

# Optional Gmail push notification support. The worker also polls Gmail history.
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_VERIFICATION_TOKEN=
